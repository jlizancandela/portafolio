---

<section class="contact" id="contact">
  <div class="contact__header">
    <span class="contact__index" aria-hidden="true">04</span>
    <h2 class="contact__title section-title">Contacto</h2>
  </div>

  <form
    class="contact__form"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    name="contact"
  >
    <p class="hidden">
      <label>Don't fill this out: <input name="bot-field" type="text" /></label>
    </p>
    <input type="hidden" name="form-name" value="contact" />
    <input type="hidden" name="subject" value="contacto de portafolio" />

    <div class="contact__fields">
      <div class="contact__field">
        <label for="name" class="contact__label">Nombre</label>
        <input
          type="text"
          name="name"
          id="name"
          placeholder="Tu nombre"
          required
          autocomplete="name"
        />
      </div>

      <div class="contact__field">
        <label for="email" class="contact__label">Email</label>
        <input
          type="email"
          name="email"
          id="email"
          placeholder="tu@email.com"
          required
          autocomplete="email"
        />
      </div>

      <div class="contact__field contact__field--full">
        <label for="message" class="contact__label">Mensaje</label>
        <textarea
          name="message"
          id="message"
          placeholder="¿En qué puedo ayudarte?"
          required></textarea>
      </div>
    </div>

    <button type="submit" class="contact__submit btn">
      Enviar mensaje
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"></path>
      </svg>
    </button>
  </form>
</section>

<style>
  .contact {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding: 4rem 2rem 6rem;
    max-width: 1100px;
    margin: auto;
    width: 100%;
  }

  .contact__header {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }

  .contact__index {
    font-family: "Playfair Display", serif;
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 700;
    font-style: italic;
    color: transparent;
    -webkit-text-stroke: 1px var(--clr-secondary);
    opacity: 0.5;
    line-height: 1;
    animation: fadeIn 0.6s ease both;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact__fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .contact__field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .contact__field--full {
    grid-column: 1 / -1;
  }

  .contact__label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--clr-muted);
  }

  input,
  textarea {
    padding: 0.75rem 1rem;
    border: 1px solid var(--clr-border);
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: "DM Sans", sans-serif;
    background: var(--clr-surface);
    color: var(--clr-text);
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
    width: 100%;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--clr-secondary);
    box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.15);
  }

  textarea {
    min-height: 120px;
    resize: vertical;
  }

  .contact__submit {
    align-self: flex-start;
  }

  .contact__submit svg {
    transition: transform 0.3s ease;
  }

  .contact__submit:hover svg {
    transform: translateX(3px);
  }

  .hidden {
    display: none;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 0.5;
    }
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 560px) {
    .contact {
      padding: 3rem 1.5rem 5rem;
    }
    .contact__fields {
      grid-template-columns: 1fr;
    }
    .contact__header {
      gap: 1rem;
    }
  }
</style>
