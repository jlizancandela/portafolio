---
const contactCards = [
  { icon: "mail", label: "Email", value: "jlizancandela@gmail.com", color: "primary" },
  { icon: "schedule", label: "Disponibilidad", value: "Abierto a oportunidades", color: "secondary" },
  { icon: "location_on", label: "Modalidad", value: "Remoto / Híbrido", color: "tertiary" },
];
const socials = [
  { label: "GitHub", handle: "jlizancandela", href: "https://github.com/jlizancandela", icon: "code" },
  { label: "LinkedIn", handle: "in/jlizancandela", href: "https://www.linkedin.com/in/jlizancandela/", icon: "work" },
];
---
<section class="contact" id="contacto"><div class="container"><div class="contact-grid"><div class="contact-info"><div class="contact-eyebrow"><span class="material-symbols-outlined" aria-hidden="true">send</span><span>Contacto Directo</span></div><h2 class="contact-title">¿Tienes un proyecto en mente? ¡Hablemos!</h2><p class="contact-lead">Estoy abierto a oportunidades junior, prácticas y proyectos colaborativos en desarrollo web.</p><div class="contact-cards">{contactCards.map((c) => <div class="contact-card"><div class={`contact-card-icon contact-card-icon--${c.color}`}><span class="material-symbols-outlined" aria-hidden="true">{c.icon}</span></div><div class="contact-card-body"><span class="contact-card-label">{c.label}</span><span class="contact-card-value">{c.value}</span></div></div>)}</div><div class="contact-socials">{socials.map((s) => <a class="contact-social" href={s.href} target="_blank" rel="noopener noreferrer"><span class="material-symbols-outlined" aria-hidden="true">{s.icon}</span><span>{s.label} / {s.handle}</span></a>)}</div></div><div class="contact-form-wrap"><form class="contact-form" method="POST" data-netlify="true" netlify-honeypot="bot-field" name="contact"><p class="hidden"><label>Don’t fill this out: <input name="bot-field" type="text" /></label></p><input type="hidden" name="form-name" value="contact" /><input type="hidden" name="subject" value="contacto de portafolio" /><div class="contact-fields-row"><div class="contact-field"><label class="contact-label" for="name">Nombre Completo *</label><input class="contact-input" type="text" name="name" id="name" placeholder="Tu nombre" required autocomplete="name" /></div><div class="contact-field"><label class="contact-label" for="email">Correo Electrónico *</label><input class="contact-input" type="email" name="email" id="email" placeholder="tu@email.com" required autocomplete="email" /></div></div><div class="contact-field"><label class="contact-label" for="message">Mensaje Detallado *</label><textarea class="contact-input contact-textarea" name="message" id="message" placeholder="¿En qué puedo ayudarte?" required rows="5"></textarea></div><button type="submit" class="contact-submit"><span>Enviar Mensaje</span><span class="material-symbols-outlined" aria-hidden="true">rocket_launch</span></button><div class="contact-meta"><span>Privacidad garantizada</span></div></form></div></div></div></section>
