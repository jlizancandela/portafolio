---
const size = "100%";
---

<section class="contact" id="contact">
  <h2 class="contact__title">Contacto</h2>
  <form
    class="contac__form"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    name="contact"
  >
    <p class="hidden">
      <label>
        Don’t fill this out if you’re human: <input
          name="bot-field"
          type="text"
        />
      </label>
    </p>
    <input type="hidden" name="form-name" value="contact" />
    <input type="hidden" name="subject" value="contacto de porfolio" />
    <label for="name">Nombre</label>
    <input type="text" name="name" id="name" placeholder="Escribe tu nombre" required />
    <label for="email">Email</label>
    <input type="email" name="email" id="email" placeholder="Escribe tu email" required />
    <label for="message">Mensaje</label>
    <textarea name="message" id="message" placeholder="Escribe tu mensaje" required></textarea>
    <button type="submit">Enviar</button>
  </form>
</section>

<style define:vars={{ size }}>
  .hidden {
    display: none;
  }
  .contact {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
    background-color: var(--clr-bg);
    border-radius: 0.5rem;
  }

  input {
    padding: 0.5rem;
    border: 2px solid var(--clr-border);
    border-radius: 0.5rem;
    font-size: 1rem;
    width: var(--size);
    display: absolute;
    color: #000;
  }

  textarea {
    padding: 0.5rem;
    border: 1px solid var(--clr-border);
    border-radius: 0.5rem;
    font-size: 1rem;
    width: var(--size);
    height: 100px;
    color: #000;
  }

  .contact__title {
    font-size: 1.5rem;
    font-weight: bold;
    text-align: center;
    margin: 5rem;
  }

  .contac__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  button {
    width: var(--size);
    height: 50px;
    border: 0;
    text-decoration: none;
    color: var(--clr-bg);
    font-size: bold;
  }
</style>
