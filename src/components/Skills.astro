---
import HtmlIcon from "../assets/icons/HtmlIcon.astro";
import CssIcon from "../assets/icons/CssIcon.astro";
import JsIcon from "../assets/icons/JsIcon.astro";
import ReactIcon from "../assets/icons/ReactIcon.astro";
import TailwindIcon from "../assets/icons/TailwindIcon.astro";
import PhpIcon from "../assets/icons/PhpIcon.astro";
import MySqlIcon from "../assets/icons/MySqlIcon.astro";
import JavaIcon from "../assets/icons/JavaIcon.astro";
import GithubICon from "../assets/icons/GithubICon.astro";
import VscodeIcon from "../assets/icons/VscodeIcon.astro";
import LinuxIcon from "../assets/icons/LinuxIcon.astro";
import VitestIcon from "../assets/icons/VitestIcon.astro";

const width = "70";
const skills = [
  { Icon: HtmlIcon, label: "HTML" },
  { Icon: CssIcon, label: "CSS" },
  { Icon: JsIcon, label: "JavaScript" },
  { Icon: ReactIcon, label: "React" },
  { Icon: VitestIcon, label: "Vitest" },
  { Icon: TailwindIcon, label: "Tailwind" },
  { Icon: PhpIcon, label: "PHP" },
  { Icon: MySqlIcon, label: "MySQL" },
  { Icon: JavaIcon, label: "Java" },
  { Icon: GithubICon, label: "GitHub" },
  { Icon: VscodeIcon, label: "VS Code" },
  { Icon: LinuxIcon, label: "Linux" },
];
---

<section class="skills">
  <div class="skills__header">
    <span class="skills__index" aria-hidden="true">02</span>
    <h2 class="skills__title section-title">Habilidades</h2>
  </div>

  <div class="skills__grid">
    {
      skills.map(({ Icon, label }, i) => (
        <div
          class="skills__item"
          style={`animation-delay: ${0.1 + i * 0.05}s`}
          title={label}
        >
          <Icon aria-label={label} width={width} />
        </div>
      ))
    }
  </div>
</section>

<style>
  .skills {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding: 4rem 2rem;
  }

  .skills__header {
    max-width: 1100px;
    margin: auto;
    width: 100%;
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }

  .skills__index {
    font-family: "Playfair Display", serif;
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 700;
    font-style: italic;
    color: transparent;
    -webkit-text-stroke: 1px var(--clr-secondary);
    opacity: 0.5;
    line-height: 1;
    animation: fadeIn 0.6s ease both;
  }

  .skills__grid {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
    max-width: 850px;
    margin: auto;
    width: 100%;
  }

  .skills__item {
    display: grid;
    place-items: center;
    width: 80px;
    height: 80px;
    border-radius: 14px;
    background: var(--clr-surface);
    border: 1px solid var(--clr-border);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    flex-shrink: 0;
  }

  .skills__item:hover {
    transform: translateY(-6px) scale(1.08);
    border-color: var(--clr-secondary);
    box-shadow: 0 8px 24px rgba(168, 85, 247, 0.2);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 0.5;
    }
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .skills {
      padding: 3rem 1.5rem;
    }
    .skills__header {
      gap: 1rem;
    }
    .skills__grid {
      gap: 1rem;
    }
    .skills__item {
      width: 68px;
      height: 68px;
    }
  }
</style>
