---
import HtmlIcon from "../assets/icons/HtmlIcon.astro";
import CssIcon from "../assets/icons/CssIcon.astro";
import JsIcon from "../assets/icons/JsIcon.astro";
import ReactIcon from "../assets/icons/ReactIcon.astro";
import TailwindIcon from "../assets/icons/TailwindIcon.astro";
import PhpIcon from "../assets/icons/PhpIcon.astro";
import MySqlIcon from "../assets/icons/MySqlIcon.astro";
import JavaIcon from "../assets/icons/JavaIcon.astro";
import GithubICon from "../assets/icons/GithubICon.astro";
import VscodeIcon from "../assets/icons/VscodeIcon.astro";
import LinuxIcon from "../assets/icons/LinuxIcon.astro";
import VitestIcon from "../assets/icons/VitestIcon.astro";
import NodeIcon from "../assets/icons/NodeIcon.astro";

const cats = [
  { title: "Frontend", lead: "Interfaces reactivas y accesibles.", icon: "devices", color: "primary", items: [[HtmlIcon, "HTML"], [CssIcon, "CSS"], [JsIcon, "JavaScript"], [ReactIcon, "React"], [TailwindIcon, "Tailwind"], [VitestIcon, "Vitest"]] },
  { title: "Backend", lead: "Lógica y persistencia de datos.", icon: "database", color: "secondary", items: [[NodeIcon, "Node.js"], [PhpIcon, "PHP"], [JavaIcon, "Java"], [MySqlIcon, "MySQL"]] },
  { title: "Herramientas", lead: "Entorno y flujo de trabajo.", icon: "terminal", color: "tertiary", items: [[GithubICon, "GitHub"], [VscodeIcon, "VS Code"], [LinuxIcon, "Linux"]] },
];
---
<section class="skills" id="habilidades"><div class="container"><div class="skills-heading"><div class="skills-eyebrow"><span class="material-symbols-outlined" aria-hidden="true">layers</span><span>Arsenal Tecnológico</span></div><h2 class="skills-title">Habilidades &amp; Tecnologías</h2><p class="skills-subtitle">Herramientas y lenguajes con los que desarrollo mis proyectos.</p></div><div class="skills-grid">{cats.map((cat) => <div class="skill-cat"><div class={`skill-icon skill-icon--${cat.color}`}><span class="material-symbols-outlined" aria-hidden="true">{cat.icon}</span></div><h3 class="skill-cat-title">{cat.title}</h3><p class="skill-cat-lead">{cat.lead}</p><div class="skill-chips">{cat.items.map(([Icon, label]) => <span class="skill-chip" title={label}><Icon width="34" aria-label={label} /><span class="skill-chip-label">{label}</span></span>)}</div></div>)}</div></div></section>
