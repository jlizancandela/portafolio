---
const navLinks = [
  { label: "Inicio", href: "#inicio" },
  { label: "Habilidades", href: "#habilidades" },
  { label: "Proyectos", href: "#proyectos" },
  { label: "Contacto", href: "#contacto" },
];
---

<header class="nav-fixed">
  <div class="nav-inner">
    <div class="nav-pill">
      <div class="nav-brand">
        <span class="nav-logo" aria-hidden="true">&lt;/&gt;</span>
        <div class="nav-brand-text">
          <span class="nav-name">Jorge Lizán</span>
          <span class="nav-role">Web Full Stack</span>
        </div>
      </div>

      <nav class="nav-links" aria-label="Navegación principal">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              data-nav-link={link.href}
              class="nav-link"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="nav-status">
        <span class="nav-status-dot" aria-hidden="true"></span>
        <span class="nav-status-text">Disponible para proyectos</span>
      </div>
    </div>
  </div>
</header>

<style>
  .nav-fixed {
    position: fixed;
    top: 0;
    inset-inline: 0;
    z-index: 50;
  }

  .nav-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-sm) var(--gutter-desktop);
  }

  .nav-pill {
    height: 4rem;
    padding-inline: var(--space-md);
    border-radius: 9999px;
    background: rgba(28, 31, 41, 0.7);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .nav-logo {
    font-family: var(--font-code);
    font-size: 1rem;
    font-weight: 600;
    color: var(--secondary);
    background: rgba(123, 208, 255, 0.1);
    border: 1px solid rgba(123, 208, 255, 0.25);
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    display: grid;
    place-items: center;
  }

  .nav-brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .nav-name {
    font-size: 18px;
    line-height: 26px;
    letter-spacing: -0.01em;
    font-weight: 600;
    color: var(--on-surface);
  }

  .nav-role {
    font-family: var(--font-code);
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--secondary);
    margin-top: 0.25rem;
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: var(--space-2xs);
    padding: 0.25rem;
    border-radius: 9999px;
    background: rgba(24, 27, 37, 0.6);
  }

  .nav-link {
    padding: 0.375rem var(--space-md);
    font-size: 13px;
    line-height: 20px;
    color: var(--on-surface-variant);
    border-radius: 9999px;
    transition: color 0.2s ease, background 0.2s ease;
    font-family: var(--font-display);
  }

  .nav-link:hover {
    color: var(--on-surface);
  }

  .nav-link--active {
    background: var(--primary-container);
    color: var(--on-primary-container);
    font-weight: 600;
  }

  .nav-status {
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background: rgba(49, 53, 63, 0.8);
    color: var(--secondary);
  }

  .nav-status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--secondary);
    animation: pulse 2s infinite;
  }

  .nav-status-text {
    font-family: var(--font-code);
    font-size: 12px;
    line-height: 18px;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  @media (min-width: 768px) {
    .nav-links {
      display: flex;
    }
  }

  @media (min-width: 1024px) {
    .nav-status {
      display: flex;
    }
  }

  @media (max-width: 640px) {
    .nav-inner {
      padding: var(--space-sm) var(--gutter-mobile);
    }
    .nav-name {
      font-size: 16px;
    }
  }
</style>

<script>
  const links = Array.from(document.querySelectorAll("[data-nav-link]"));

  const setActive = (href) => {
    links.forEach((link) => {
      const active = link.dataset.navLink === href;
      link.classList.toggle("nav-link--active", active);
    });
  };

  const onScroll = () => {
    const scrollY = window.scrollY;
    const viewport = window.innerHeight;
    const midpoint = viewport / 2;

    let activeHref = links[0]?.dataset.navLink;
    let closestDistance = Number.POSITIVE_INFINITY;

    links.forEach((link) => {
      const el = document.querySelector(link.dataset.navLink);
      if (!el) return;
      const rect = el.getBoundingClientRect();

      // Keep the active link tied to the section containing the viewport midpoint.
      if (rect.top <= midpoint && rect.bottom > midpoint) {
        activeHref = link.dataset.navLink;
        closestDistance = 0;
        return;
      }

      // Use the nearest section while the midpoint is between two sections.
      const distance = Math.min(Math.abs(rect.top - midpoint), Math.abs(rect.bottom - midpoint));
      if (distance < closestDistance) {
        closestDistance = distance;
        activeHref = link.dataset.navLink;
      }
    });

    if (scrollY < 80) {
      activeHref = links[0]?.dataset.navLink;
    }

    setActive(activeHref);
  };

  links.forEach((link) => {
    link.addEventListener("click", () => setActive(link.dataset.navLink));
  });

  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll);
  onScroll();
</script>
