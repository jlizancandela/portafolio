---
import GithubICon from "../assets/GithubICon.astro";
import LinkedInIcon from "../assets/LinkedInIcon.astro";
---

<header>
  <nav class="navbar">
    <ul class="navbar__menu">
      <li class="navbar__item">
        <a href="/" class="navbar__link">Inicio</a>
      </li>
      <li class="navbar__item">
        <a href="/proyectos" class="navbar__link">Proyectos</a>
      </li>
      <li class="navbar__item">
        <a href="/contacto" class="navbar__link">Contacto</a>
      </li>
      <li class="navbar__item">
        <a href="https://github.com/JorgeAntrax" class="navbar__link">
          <GithubICon aria-label="GitHub" width="20" height="20" />
        </a>
      </li>
      <li class="navbar__item">
        <a
          href="https://www.linkedin.com/in/jorge-antrax-b-a-c-a-n-d-o-r-e-s-1b1a1a195/"
          class="navbar__link"
        >
          <LinkedInIcon aria-label="LinkedIn" width="20" height="20" />
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .navbar {
    display: flex;
    flex-direction: row-reverse;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
  }

  .navbar__menu {
    display: flex;
    flex-direction: row;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    list-style: none;
    a {
      text-decoration: none;
      color: black;
      display: flex;
      align-items: center;
    }
  }
</style>
