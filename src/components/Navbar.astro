---
const navLinks = [
  { label: "Inicio", href: "#inicio" },
  { label: "Habilidades", href: "#habilidades" },
  { label: "Proyectos", href: "#proyectos" },
  { label: "Contacto", href: "#contacto" },
];
---

<header class="nav-fixed">
  <div class="nav-inner">
    <div class="nav-pill">
      <div class="nav-brand">
        <span class="nav-logo" aria-hidden="true">&lt;/&gt;</span>
        <div class="nav-brand-text">
          <span class="nav-name">Jorge Lizán</span>
          <span class="nav-role">Web Full Stack</span>
        </div>
      </div>

      <nav class="nav-links" aria-label="Navegación principal">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              data-nav-link={link.href}
              class="nav-link"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="nav-status">
        <span class="nav-status-dot" aria-hidden="true"></span>
        <span class="nav-status-text">Disponible para proyectos</span>
      </div>

      <div class="nav-theme" aria-label="Preferencia de tema" data-theme-switcher>
        <button class="theme-option" type="button" data-theme-option="light" aria-label="Tema claro" aria-pressed="false">
          <span class="material-symbols-outlined" aria-hidden="true">light_mode</span>
        </button>
        <button class="theme-option" type="button" data-theme-option="system" aria-label="Usar preferencias del sistema" aria-pressed="true">
          <span class="material-symbols-outlined" aria-hidden="true">contrast</span>
        </button>
        <button class="theme-option" type="button" data-theme-option="dark" aria-label="Tema oscuro" aria-pressed="false">
          <span class="material-symbols-outlined" aria-hidden="true">dark_mode</span>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const links = Array.from(document.querySelectorAll("[data-nav-link]"));

  const setActive = (href) => {
    links.forEach((link) => {
      const active = link.dataset.navLink === href;
      link.classList.toggle("nav-link--active", active);
    });
  };

  const onScroll = () => {
    const scrollY = window.scrollY;
    const viewport = window.innerHeight;
    const midpoint = viewport / 2;

    let activeHref = links[0]?.dataset.navLink;
    let closestDistance = Number.POSITIVE_INFINITY;

    links.forEach((link) => {
      const el = document.querySelector(link.dataset.navLink);
      if (!el) return;
      const rect = el.getBoundingClientRect();

      // Keep the active link tied to the section containing the viewport midpoint.
      if (rect.top <= midpoint && rect.bottom > midpoint) {
        activeHref = link.dataset.navLink;
        closestDistance = 0;
        return;
      }

      // Use the nearest section while the midpoint is between two sections.
      const distance = Math.min(Math.abs(rect.top - midpoint), Math.abs(rect.bottom - midpoint));
      if (distance < closestDistance) {
        closestDistance = distance;
        activeHref = link.dataset.navLink;
      }
    });

    if (scrollY < 80) {
      activeHref = links[0]?.dataset.navLink;
    }

    setActive(activeHref);
  };

  links.forEach((link) => {
    link.addEventListener("click", () => setActive(link.dataset.navLink));
  });

  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll);
  onScroll();

  const themeOptions = Array.from(document.querySelectorAll("[data-theme-option]"));
  const setTheme = (theme) => {
    document.documentElement.dataset.theme = theme;
    localStorage.setItem("portfolio-theme", theme);
    themeOptions.forEach((option) => {
      option.setAttribute("aria-pressed", String(option.dataset.themeOption === theme));
    });
  };

  themeOptions.forEach((option) => {
    option.addEventListener("click", () => setTheme(option.dataset.themeOption));
  });
  setTheme(localStorage.getItem("portfolio-theme") || "system");
</script>
