---
import { Image } from "astro:assets";
import down from "../assets/down.svg";
import clipboard from "../assets/clipboard.svg";
---

<section class="hero">
  <div class="hero__grid">
    <div class="hero__content">
      <h1>
        Hola 👋 Soy <span>Jorge Lizan</span>, desarrollador web Trainee en
        proceso de aprendizaje.
      </h1>
      <div class="hero__buttons">
        <button class="hero__button curriculum">Currículum</button>
        <div class="hero__mail">
          <button class="hero__button mail">jlizancandela@gmail.com</button>
          <button class="hero__button clipboard">
            <Image src={clipboard} alt="clipboard" width="20" height="20" />
          </button>
        </div>
      </div>
    </div>
    <div class="hero__image">
      <Image
        src="https://dummyjson.com/image/300"
        alt="Jorge Lizan"
        class="hero__image"
        width="300"
        height="300"
      />
    </div>
  </div>

  <div class="hero__footer">
    <Image src={down} alt="abajo" width="30" />
  </div>
</section>

<script>
  const mailButton = document.querySelector(".mail");
  const proyectosButton = document.querySelector(".curriculum");
  const clipboardButton = document.querySelector(".clipboard");

  const proyectos = () => window.open("/Curriculum.pdf", "_blank");
  const mailto = () => window.open("mailto:jlizancandela@gmail.com", "_blank");
  const clipboard = () =>
    navigator.clipboard.writeText("jlizancandela@gmail.com");

  clipboardButton?.addEventListener("click", clipboard);
  mailButton?.addEventListener("click", mailto);
  proyectosButton?.addEventListener("click", proyectos);
</script>

<style>
  .hero {
    background-color: #fff;
    height: 90dvh; /* ocupa exactamente el viewport */
    display: flex;
    flex-direction: column;
    justify-content: space-between; /* contenido arriba/centro y flecha abajo */
    align-items: center;
    overflow: hidden; /* evita scroll innecesario */
    padding: 2rem 1rem; /* aire interno en vez de margin que rompe */
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    width: 100%;
    max-width: 1100px;
    margin: auto;
    align-items: center;
    flex: 1; /* ocupa todo el espacio disponible */
  }

  @media (max-width: 800px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .hero__image {
      justify-content: center;
      margin-top: 2rem;
    }
    .hero__content {
      align-items: center;
      text-align: center;
    }
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 2rem;
  }

  .hero__buttons {
    display: flex;
    flex-direction: row;
    gap: 1rem;
    width: 100%;
    margin-top: 1rem;
  }

  .hero__button {
    width: 50%;
    height: 50px;
    border: 0;
    text-decoration: none;
    color: black;
  }

  .curriculum {
    border-radius: 2rem;
  }

  .hero__mail {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    width: 50%;
  }

  .mail {
    flex: 1;
    border-radius: 2rem 0 0 2rem;
    text-overflow: ellipsis;
    overflow: hidden;
    padding-inline: 1rem;
  }

  .clipboard {
    flex: 0;
    padding: 0 1rem;
    border-radius: 0 2rem 2rem 0;
  }

  .hero__button:hover {
    box-shadow: 0 0 10px rgba(186, 12, 229, 0.809);
  }

  .hero__content > h1 {
    font-size: 2.5rem;
    font-weight: bold;
    margin: auto;
    text-wrap: balance;
  }

  .hero__content > h1 > span {
    background: linear-gradient(purple, blue);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__image {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero__image img {
    width: 300px;
    height: 300px;
    border-radius: 50%;
    border: 6px solid transparent;
    background:
      url("https://dummyjson.com/image/300") center/cover no-repeat,
      linear-gradient(45deg, blue, indigo, violet);
    background-origin: padding-box, border-box;
    background-clip: padding-box, border-box;
  }

  .hero__footer {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-bottom: 1rem;
    animation: bounce 2s infinite ease-in-out;
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
</style>
