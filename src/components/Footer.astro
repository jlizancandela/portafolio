---
const socials = [
  { label: "GitHub", href: "https://github.com/jlizancandela", icon: "code" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/jlizancandela/", icon: "work" },
  { label: "Email", href: "mailto:jlizancandela@gmail.com", icon: "mail" },
];
---
<footer class="footer">
  <div class="container"><div class="footer-inner">
    <div class="footer-brand"><span class="footer-logo" aria-hidden="true">&lt;/&gt;</span><span class="footer-tagline">Jorge Lizán • Construyendo aplicaciones web full stack</span></div>
    <div class="footer-socials">{socials.map((s) => <a class="footer-social" href={s.href} target="_blank" rel="noopener noreferrer"><span class="material-symbols-outlined" aria-hidden="true">{s.icon}</span><span>{s.label}</span></a>)}</div>
    <div class="footer-copy">© 2026 Jorge Lizán. Todos los derechos reservados.</div>
  </div></div>
</footer>
