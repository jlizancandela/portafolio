---
import LinkIcon from "../../assets/icons/LinkIcon.astro";
import GithubICon from "../../assets/icons/GithubICon.astro";

interface ProjectProps {
  url?: string;
  github?: string;
  nombre: string;
}

const { project } = Astro.props as { project: ProjectProps };
---

<div class="project__links">
  {
    project.url && (
      <a
        href={project.url}
        target="_blank"
        rel="noopener noreferrer"
        class="project__link project__link--primary"
        aria-label={`Ver demo de ${project.nombre}`}
      >
        <LinkIcon width="16" height="16" />
        <span>Demo</span>
      </a>
    )
  }
  {
    project.github && (
      <a
        href={project.github}
        target="_blank"
        rel="noopener noreferrer"
        class="project__link"
        aria-label={`Ver ${project.nombre} en GitHub`}
      >
        <GithubICon width="16" height="16" />
        <span>GitHub</span>
      </a>
    )
  }
</div>

<style>
  .project__links {
    display: flex;
    align-items: stretch;
    gap: 0.75rem;
    height: 100%;
  }

  .project__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    height: 100%;
    box-sizing: border-box;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0 0.75rem;
    border-radius: 4px;
    border: 1px solid var(--clr-border);
    color: var(--clr-text);
    background: var(--clr-bg);
    transition: all 0.25s ease;
  }

  .project__link:hover {
    border-color: var(--clr-secondary);
    color: var(--clr-secondary);
    transform: translateY(-1px);
    text-shadow: none;
  }

  .project__link--primary {
    background: linear-gradient(135deg, var(--clr-primary), var(--clr-secondary));
    color: white;
    border-color: transparent;
  }

  .project__link--primary:hover {
    color: white;
    border-color: transparent;
    opacity: 0.85;
    box-shadow: 0 4px 12px rgba(168, 85, 247, 0.3);
  }
</style>
