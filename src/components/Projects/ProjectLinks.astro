---
import LinkIcon from "../../assets/icons/LinkIcon.astro";
import GithubICon from "../../assets/icons/GithubICon.astro";

interface ProjectProps {
  url: string;
  github: string;
  nombre: string;
}

const { project } = Astro.props;
---

<div class="proyect__links">
  <a href={project.url} target="_blank" rel="noopener noreferrer" class="proyect__link projet__link--primary">
    <LinkIcon width="16" height="16" />
    <span>Live</span>
  </a>
  <a href={project.github} target="_blank" rel="noopener noreferrer" class="proyect__link">
    <GithubICon width="16" height="16" />
    <span>Code</span>
  </a>
</div>

<style>
  .proyect__links {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .proyect__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: 4px;
    border: 1px solid var(--clr-border);
    color: var(--clr-text);
    background: var(--clr-bg);
    transition: all 0.25s ease;
  }

  .proyect__link:hover {
    border-color: var(--clr-secondary);
    color: var(--clr-secondary);
    transform: translateY(-1px);
    text-shadow: none;
  }

  .proyect__link--primary {
    background: linear-gradient(135deg, var(--clr-primary), var(--clr-secondary));
    color: white;
    border-color: transparent;
  }

  .proyect__link--primary:hover {
    color: white;
    border-color: transparent;
    opacity: 0.85;
    box-shadow: 0 4px 12px rgba(168, 85, 247, 0.3);
  }
</style>
