---
import projects from "../../assets/projects.json";
import Project from "./Project.astro";

interface ProjectData {
  nombre: string;
  imagen: string;
  descripcion: string;
  stack: string;
  url?: string;
  github?: string;
}
---

<section class="projects" id="proyectos">
  <div class="container">
    <div class="projects-header">
      <div class="projects-heading">
        <div class="projects-eyebrow"><span class="material-symbols-outlined" aria-hidden="true">developer_board</span><span>Portafolio &amp; Entregas</span></div>
        <h2 class="projects-title">Proyectos Destacados</h2>
        <p class="projects-subtitle">Una selección de aplicaciones web que he construido de principio a fin.</p>
      </div>
    </div>
    <div class="projects-list">
      {projects.projects.map((project: ProjectData, i: number) => <Project {...project} index={i} variant={i === 0 ? "featured" : "default"} />)}
    </div>
  </div>
</section>
