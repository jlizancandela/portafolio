---
import projects from "../../assets/projects.json";
import Project from "./Project.astro";

interface Project {
  nombre: string;
  imagen: string;
  Descipción: string;
  stack: string;
  url: string;
  github: string;
}
---

<section class="proyects" id="proyectos">
  <div class="proyects__header">
    <span class="proyects__index" aria-hidden="true">02</span>
    <h2 class="proyects__title section-title">Proyectos</h2>
  </div>
  <section class="proyects__list">
    {projects.projects.map((project: Project, i: number) => <Project {...project} index={i} />)}
  </section>
</section>

<style>
  .proyects {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding: 4rem 2rem;
    position: relative;
  }

  .proyects__header {
    max-width: 1100px;
    margin: auto;
    width: 100%;
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }

  .proyects__index {
    font-family: 'Playfair Display', serif;
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 700;
    font-style: italic;
    color: transparent;
    -webkit-text-stroke: 1px var(--clr-secondary);
    opacity: 0.5;
    line-height: 1;
    animation: fadeIn 0.6s ease both;
  }

  .proyects__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 320px));
    gap: 2.5rem;
    justify-content: center;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 0.5; }
  }

  @media (max-width: 640px) {
    .proyects {
      padding: 3rem 1.5rem;
    }
    .proyects__header {
      gap: 1rem;
    }
  }
</style>
