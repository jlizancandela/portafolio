---
import projects from "../../assets/projects.json";
import Project from "./Project.astro";

interface ProjectData {
  nombre: string;
  imagen: string;
  descripcion: string;
  stack: string;
  url?: string;
  github?: string;
}
---

<section class="projects" id="proyectos">
  <div class="container">
    <div class="projects-header">
      <div class="projects-heading">
        <div class="projects-eyebrow">
          <span class="material-symbols-outlined" aria-hidden="true">developer_board</span>
          <span>Portafolio &amp; Entregas</span>
        </div>
        <h2 class="projects-title">Proyectos Destacados</h2>
        <p class="projects-subtitle">
          Una selección de aplicaciones web que he construido de principio a fin.
        </p>
      </div>
    </div>

    <div class="projects-list">
      {
        projects.projects.map((project: ProjectData, i: number) => (
          <Project {...project} index={i} />
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects {
    padding: var(--space-3xl) 0;
    position: relative;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--gutter-desktop);
  }

  .projects-header {
    margin-bottom: var(--space-2xl);
  }

  .projects-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .projects-eyebrow .material-symbols-outlined {
    font-size: 22px;
    color: var(--secondary);
  }

  .projects-eyebrow span:last-child {
    font-family: var(--font-code);
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--secondary);
  }

  .projects-title {
    font-size: 28px;
    line-height: 36px;
    letter-spacing: -0.02em;
    font-weight: 700;
    color: var(--on-surface);
    margin: 0;
  }

  .projects-subtitle {
    font-size: 15px;
    line-height: 24px;
    color: var(--on-surface-variant);
    margin-top: 0.25rem;
  }

  @media (min-width: 768px) {
    .projects-title {
      font-size: 40px;
      line-height: 48px;
      letter-spacing: -0.025em;
    }
  }

  .projects-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 1024px) {
    .projects-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .container {
      padding: 0 var(--gutter-mobile);
    }
  }
</style>
