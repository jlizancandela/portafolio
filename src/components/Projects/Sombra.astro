---
---

<div class="proyect-wrap">
  <slot />
</div>

<style>
  @property --angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }

  @keyframes spin-border {
    to {
      --angle: 360deg;
    }
  }

  .proyect-wrap {
    position: relative;
    border-radius: 0.75rem;
    overflow: visible;
    transition: transform 0.3s ease;
  }

  .proyect-wrap::after {
    content: "";
    position: absolute;
    inset: -12px;
    border-radius: inherit;
    background: conic-gradient(
      from var(--angle),
      var(--clr-primary),
      var(--clr-secondary),
      var(--clr-accent),
      var(--clr-secondary),
      var(--clr-primary)
    );
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    filter: blur(12px);
    transition: opacity 0.4s ease;
    animation: spin-border 4s infinite linear;
  }

  .proyect-wrap:hover::after {
    opacity: 0.7;
  }
</style>
