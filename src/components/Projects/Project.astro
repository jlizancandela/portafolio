---
import Sombra from "./Sombra.astro";
import ProjectLinks from "./ProjectLinks.astro";

interface Props {
  nombre: string;
  imagen: string;
  descripcion: string;
  stack: string;
  url: string;
  github: string;
  index?: number;
}

const { nombre, imagen, descripcion, stack, url, github, index = 0 } = Astro.props;
const delay = 0.15 + index * 0.1;
---

<Sombra>
  <article class="project" style={`animation-delay: ${delay}s`}>
    <div class="project__image-wrap">
      <img class="project__image" src={imagen} alt={`Captura de ${nombre}`} loading="lazy" />
      <div class="project__image-overlay"></div>
    </div>

    <div class="project__info">
      <h3 class="project__name">{nombre}</h3>
      <p class="project__description">{descripcion}</p>

      <div class="project__stack">
        <span class="project__stack-label">Stack</span>
        <span class="project__stack-tags">
          {stack.split(',').map((s: string) => (
            <span class="project__tag">{s.trim()}</span>
          ))}
        </span>
      </div>

      <ProjectLinks project={{ url, github, nombre }} />
    </div>
  </article>
</Sombra>

<style>
  .project {
    display: flex;
    flex-direction: column;
    border-radius: 0.75rem;
    align-items: stretch;
    width: 300px;
    min-height: 480px;
    background: var(--clr-surface);
    overflow: hidden;
    z-index: 1;
    position: relative;
    color: var(--clr-text);
    animation: cardReveal 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
    transition: transform 0.3s ease;
  }

  .project:hover {
    transform: translateY(-4px);
  }

  @keyframes cardReveal {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .project__image-wrap {
    position: relative;
    overflow: hidden;
  }

  .project__image {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .project:hover .project__image {
    transform: scale(1.04);
  }

  .project__image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 60%, rgba(0,0,0,0.15) 100%);
    pointer-events: none;
  }

  .project__info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    flex: 1;
  }

  .project__name {
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--clr-primary);
    text-align: left;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .project__description {
    font-size: 0.85rem;
    color: var(--clr-muted);
    line-height: 1.6;
    margin: 0;
  }

  .project__stack {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .project__stack-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--clr-secondary);
  }

  .project__stack-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .project__tag {
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    background: var(--clr-bg);
    color: var(--clr-text);
    border: 1px solid var(--clr-border);
  }
</style>
