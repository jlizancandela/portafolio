---
interface Props {
  nombre: string;
  imagen: string;
  descripcion: string;
  stack: string;
  url?: string;
  github?: string;
  index?: number;
  variant?: "default" | "featured";
}

const { nombre, imagen, descripcion, stack, url, github, index = 0, variant = "default" } = Astro.props;
---

<article class:list={["project-card", `project-card--${variant}`]} data-index={index}>
  <div class="project-media">
    <img class="project-image" src={imagen} alt={`Captura de ${nombre}: ${descripcion}`} loading="lazy" />
    <div class="project-overlay" aria-hidden="true"></div>
  </div>
  <div class="project-body">
    <h3 class="project-name">{nombre}</h3>
    <p class="project-desc">{descripcion}</p>
    <div class="project-tags">
      {stack.split(",").map((s: string) => <span class="project-tag">{s.trim()}</span>)}
    </div>
    <div class="project-actions">
      {url && <a class="project-btn project-btn--primary" href={url} target="_blank" rel="noopener noreferrer"><span class="material-symbols-outlined" aria-hidden="true">open_in_new</span><span>Ver Demo</span></a>}
      {github && <a class="project-btn project-btn--ghost" href={github} target="_blank" rel="noopener noreferrer"><span class="material-symbols-outlined" aria-hidden="true">code</span><span>Código</span></a>}
    </div>
  </div>
</article>
