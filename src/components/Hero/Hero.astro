---
import HeroContent from "./HeroContent.astro";
import HeroPhoto from "./HeroPhoto.astro";
import { socials } from "../../data/socials";
---

<section class="hero" id="inicio">
  <div class="hero-ambient hero-ambient--1" aria-hidden="true"></div>
  <div class="hero-ambient hero-ambient--2" aria-hidden="true"></div>

  <div class="hero-container">
    <div class="hero-grid">
      <div class="hero-col-left">
        <HeroContent socials={socials} />
      </div>
      <div class="hero-col-right">
        <HeroPhoto />
      </div>
    </div>
  </div>

  <a
    class="hero-scroll"
    href="#habilidades"
    title="Desplazarse a la sección de habilidades y tecnologías"
  >
    <span class="sr-only">Ir a la sección de habilidades</span>
    <span class="material-symbols-outlined hero-scroll-icon" aria-hidden="true">keyboard_arrow_down</span>
  </a>
</section>
