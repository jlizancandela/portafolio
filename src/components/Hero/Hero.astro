---
import HeroContent from "./HeroContent.astro";
import HeroFooter from "./HeroFooter.astro";
import Photo from "./Photo.astro";
---

<section class="hero">
  <div class="hero__grid">
    <HeroContent />
    <Photo />
  </div>

  <HeroFooter />
</section>

<style>
  .hero {
    background-color: var(--clr-bg);
    /* Evita cortes en móviles permitiendo que crezca si hace falta */
    min-height: 100dvh;
    height: auto; /* no forzar altura fija */
    display: flex;
    flex-direction: column;
    justify-content: space-between; /* contenido arriba/centro y flecha abajo */
    align-items: center;
    /* Permitir que el contenido salga si es más alto que el viewport */
    overflow: visible;
    padding: 2rem 1rem;
    color: var(--clr-text);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    width: 100%;
    max-width: 1100px;
    margin: auto;
    align-items: center;
    flex: 1; /* ocupa todo el espacio disponible */
    transform: translateY(-2rem);
  }

  @media (max-width: 800px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 3rem;
      transform: translateY(-1rem);
    }
  }
</style>
