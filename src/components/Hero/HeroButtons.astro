---
import ClipboardIcon from "../../assets/icons/ClipboardIcon.astro";
---

<div class="hero__buttons">
  <button class="hero__button btn">Currículum</button>
  <button class="hero__button btn">jlizancandela@gmail.com</button>
  <button class="hero__button clipboard">
    <ClipboardIcon width="20" height="20" />
  </button>
</div>

<script>
  const proyectosButton = document.querySelector(".hero__button.btn:first-child");
  const mailButton = document.querySelector(".hero__button.btn:nth-child(2)");
  const clipboardButton = document.querySelector(".clipboard");

  const proyectos = () => window.open("/Curriculum.pdf", "_blank");
  const mailto = () => window.open("mailto:jlizancandela@gmail.com", "_blank");
  const clipboard = () =>
    navigator.clipboard.writeText("jlizancandela@gmail.com");

  clipboardButton?.addEventListener("click", clipboard);
  mailButton?.addEventListener("click", mailto);
  proyectosButton?.addEventListener("click", proyectos);
</script>

<style>
  .hero__buttons {
    display: flex;
    flex-direction: row;
    gap: 1rem;
    width: 100%;
    margin-top: 1rem;
  }

  .hero__button {
    width: 50%;
    height: 50px;
  }

  .hero__button.clipboard {
    width: auto;
    background: transparent;
    border: none;
    padding: 0;
  }

  .hero__button.clipboard :global(svg) {
    fill: none !important;
    stroke: var(--clr-text) !important;
    transition: stroke 0.3s ease, transform 0.3s ease;
  }

  .hero__button.clipboard:hover :global(svg) {
    stroke: var(--clr-accent) !important;
    transform: scale(1.15);
  }

  @media (max-width: 800px) {
    .hero__buttons {
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    .hero__button {
      width: min(420px, 90vw);
      height: clamp(40px, 9.5vw, 48px);
    }

    .hero__button.clipboard {
      width: clamp(40px, 9.5vw, 48px);
      height: clamp(40px, 9.5vw, 48px);
    }
  }
</style>
