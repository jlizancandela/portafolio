---
import ClipboardIcon from "../../assets/icons/ClipboardIcon.astro";
---

<div class="hero__buttons">
  <button class="hero__button curriculum">Currículum</button>
  <div class="hero__mail">
    <button class="hero__button mail">jlizancandela@gmail.com</button>
    <button class="hero__button clipboard">
      <ClipboardIcon width="20" height="20" />
    </button>
  </div>
</div>

<script>
  const mailButton = document.querySelector(".mail");
  const proyectosButton = document.querySelector(".curriculum");
  const clipboardButton = document.querySelector(".clipboard");

  const proyectos = () => window.open("/Curriculum.pdf", "_blank");
  const mailto = () => window.open("mailto:jlizancandela@gmail.com", "_blank");
  const clipboard = () =>
    navigator.clipboard.writeText("jlizancandela@gmail.com");

  clipboardButton?.addEventListener("click", clipboard);
  mailButton?.addEventListener("click", mailto);
  proyectosButton?.addEventListener("click", proyectos);
</script>

<style>
  .hero__buttons {
    display: flex;
    flex-direction: row;
    gap: 1rem;
    width: 100%;
    margin-top: 1rem;
  }

  .hero__button {
    width: 50%;
    height: 50px;
    border: 0;
    text-decoration: none;
    font-weight: bold;
    font-size: 0.8rem;
    font-family: "Roboto";
  }

  .hero__mail {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    width: 50%;
  }

  .mail {
    flex: 1;
    text-overflow: ellipsis;
    overflow: hidden;
    padding-inline: 1rem;
  }

  .clipboard {
    flex: 0;
    background: transparent;
  }

  /* En móviles: botones más pequeños y centrados en columna */
  @media (max-width: 800px) {
    .hero__buttons {
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    .hero__button {
      width: min(420px, 90vw);
      height: clamp(40px, 9.5vw, 48px);
      font-size: 0.85rem;
    }

    .hero__mail {
      width: min(420px, 90vw);
    }

    .clipboard {
      height: clamp(40px, 9.5vw, 48px);
      width: clamp(40px, 9.5vw, 48px);
      display: grid;
      place-items: center;
    }
  }
</style>
