---
import HeroButtons from "./HeroButtons.astro";
---

<div class="hero__content">
  <h1>
    Hola 👋 Soy <span>Jorge Lizán</span>, desarrollador web full stack junior
  </h1>
  <p class="hero__subtitle">
    Construyo aplicaciones web completas con PHP, JavaScript, TypeScript, React y bases de datos SQL. Busco una primera oportunidad en desarrollo web o mantenimiento de aplicaciones.
  </p>
  <HeroButtons />
</div>

<style>
  @media (max-width: 800px) {
    .hero__content {
      align-items: center;
      text-align: center;
    }
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1.5rem;
  }

  .hero__content > h1 {
    font-size: clamp(1.5rem, 5.5vw, 2.5rem);
    line-height: 1.2;
    font-weight: bold;
    margin: 0;
    text-wrap: balance;
  }

  .hero__content > h1 > span {
    background: linear-gradient(purple, blue);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-size: inherit;
  }

  .hero__subtitle {
    max-width: 38rem;
    margin: 0;
    color: var(--clr-muted);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
    text-wrap: balance;
  }
</style>
