---
const { socials = [] } = Astro.props;
---

<div class="hero-content">
  <div class="hero-pill">
    <span class="hero-pill-dot" aria-hidden="true"></span>
    <span class="hero-pill-text">👋 Hola mundo, soy desarrollador Web Full Stack</span>
  </div>

  <h1 class="hero-title">
    Hola 👋 Soy <span class="hero-title-grad">Jorge Lizán</span>,<br />
    desarrollador web full stack junior
  </h1>

  <p class="hero-lead">
    Construyo aplicaciones web completas con <span class="hl-primary">PHP</span>,{" "}
    <span class="hl-secondary">JavaScript</span>,{" "}
    <span class="hl-tertiary">TypeScript</span>, React y bases de datos SQL. Busco
    una primera oportunidad en desarrollo web o mantenimiento de aplicaciones.
  </p>

  <div class="hero-actions">
    <a class="btn-primary" href="#contacto">
      <span class="material-symbols-outlined" aria-hidden="true">mail</span>
      <span>Contactar por Email</span>
    </a>
    <a class="btn-ghost" href="/Curriculum.pdf" download>
      <span class="material-symbols-outlined" aria-hidden="true">download</span>
      <span>Descargar Currículum</span>
    </a>
  </div>

  <div class="hero-socials">
    {
      socials.map((s) => (
        <a
          class="hero-social"
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="material-symbols-outlined" aria-hidden="true">{s.icon}</span>
          <span>{s.label}</span>
        </a>
      ))
    }
  </div>
</div>
