---
import Navbar from "../components/Navbar.astro";
import "../styles/portfolio.css";
import Mouse from "../components/Mouse.astro";
import Footer from "../components/Footer.astro";
import { Chatbox } from "@jlizancandela/chatbox";

const siteUrl = "https://jorgelizancandela.com";
// La URL del API del chat. Llega del entorno de build (Netlify → PUBLIC_CHATBOX_API_URL).
// El prefijo PUBLIC_ es lo que permite a Astro entregarla al navegador, y el widget corre
// en el navegador: sin él la variable no existiría en el cliente.
const chatboxApiUrl = import.meta.env.PUBLIC_CHATBOX_API_URL;
const siteDescription =
  "Portfolio de Jorge Lizán Candela, desarrollador web full stack junior especializado en PHP, JavaScript, TypeScript, React y bases de datos SQL.";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      name: "Jorge Lizán Candela",
      url: `${siteUrl}/`,
      jobTitle: "Desarrollador web full stack junior",
      description: siteDescription,
      sameAs: [
        "https://github.com/jlizancandela",
        "https://www.linkedin.com/in/jlizancandela/"
      ]
    },
    {
      "@type": "WebSite",
      name: "Portfolio de Jorge Lizán Candela",
      url: `${siteUrl}/`,
      inLanguage: "es"
    }
  ]
};
---

<!doctype html>
<html data-theme="system" lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={`${siteUrl}/`} />
    <title>Jorge Lizán Candela — Desarrollador Full Stack</title>
    <meta property="og:title" content="Jorge Lizán Candela — Desarrollador Full Stack" />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={`${siteUrl}/`} />
    <meta property="og:site_name" content="Portfolio de Jorge Lizán Candela" />
    <meta property="og:locale" content="es_ES" />
    <meta
      property="og:image"
      content="https://ik.imagekit.io/jlc84/portfolio/social_4JbAwi3bl?updatedAt=1756839084645"/>
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@jlizancandela" />
    <meta name="twitter:creator" content="@jlizancandela" />
    <meta name="twitter:title" content="Jorge Lizán Candela — Desarrollador Full Stack" />
    <meta name="twitter:description" content={siteDescription} />
    <meta
      name="twitter:image"
      content="https://ik.imagekit.io/jlc84/portfolio/social_4JbAwi3bl?updatedAt=1756839084645"
    />
    <meta name="twitter:image:alt" content="Portfolio de Jorge Lizán Candela" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <script is:inline>
      const savedTheme = localStorage.getItem("portfolio-theme");
      document.documentElement.dataset.theme = savedTheme || "system";
    </script>
  </head>
  <body>
    <Navbar />
    <main class="page-main">
      <slot />
      <Mouse />
    </main>
    <Footer />
    {
      /* El widget solo se monta si hay URL de API. Sin ella, el build de un entorno
         que no la tenga (una previsualización, por ejemplo) no rompe el sitio: sale
         sin chat. `client:only` porque el widget es puramente interactivo y usa
         almacenamiento del navegador desde el primer render. */
      chatboxApiUrl && (
        <Chatbox client:only="preact" apiUrl={chatboxApiUrl} />
      )
    }
  </body>
</html>
