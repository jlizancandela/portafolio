---
import Navbar from "../components/Navbar.astro";
import "../layouts/Layouts.css";
import Mouse from "../components/Mouse.jsx";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Portafolio de Jorge L. Candela</title>
    <meta property="og:title" content="Portafolio de Jorge L. Candela" />
    <meta
      property="og:description"
      content="Portafolio de Jorge L. Candela, desarrollador web Trainee en proceso de aprendizaje."
    />
    <meta
      property="og:image"
      content="https://ik.imagekit.io/jlc84/portfolio/social_4JbAwi3bl?updatedAt=1756839084645"/>
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@jlizancandela" />
    <meta name="twitter:creator" content="@jlizancandela" />
    <meta name="twitter:title" content="Portafolio de Jorge L. Candela" />
    <meta
      name="twitter:description"
      content="Portafolio de Jorge L. Candela, desarrollador web Trainee en proceso de aprendizaje."
    />
    <meta
      name="twitter:image"
      content="https://ik.imagekit.io/jlc84/portfolio/social_4JbAwi3bl?updatedAt=1756839084645"
    />

  </head>
  <body>
    <Navbar />
    <main id="main">
      <slot />
      <Mouse client:load />
    </main>
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    font-size: large;
    font-family: "Roboto", sans-serif;
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    scroll-behavior: smooth;
  }

  main {
    max-width: 1100px;
    width: 100%;
    margin: auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: center;
  }
</style>
